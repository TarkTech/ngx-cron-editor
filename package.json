{
  "name": "@cardiosmircem/ngx-cron-editor",
  "description": "A cron expression generator with translations for Angular",
  "version": "1.0.2",
  "main": "dist/cron-editor/fesm2022/cardiosmircem-ngx-cron-editor.mjs",
  "module": "dist/cron-editor/fesm2022/cardiosmircem-ngx-cron-editor.mjs",
  "typings": "dist/cron-editor/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cron-editor/index.d.ts",
      "default": "./dist/cron-editor/fesm2022/cardiosmircem-ngx-cron-editor.mjs"
    }
  },
  "scripts": {
    "ng": "ng",
    "prepare": "ng build cron-editor",
    "postprepare": "npm install --ignore-scripts --no-audit --no-fund",
    "start": "ng serve",
    "build": "ng build cron-editor && ng build",
    "build:lib": "ng build cron-editor",
    "pub": "cd libs/cron-editor && npm publish --access public"
  },
  "optionalDependencies": {
    "@cardiosmircem/ngx-cron-editor": "file:dist/cron-editor"
  },
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@ngx-translate/core": "^16.0.0",
    "@ngx-translate/http-loader": "^16.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-devkit/core": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/language-service": "^20.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.0.0",
    "jasmine-core": "~5.6.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-cli": "~2.0.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^20.0.0",
    "standard-version": "^9.3.0",
    "ts-node": "~10.9.0",
    "typescript": "~5.8.0"
  }
}
